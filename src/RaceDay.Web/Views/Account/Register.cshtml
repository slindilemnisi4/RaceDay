@model RaceDay.Web.Models.Account.RegisterViewModel
@{
    ViewData["Title"] = "Create account";
}

<section class="account-card" aria-labelledby="register-heading">
    <p class="account-card__eyebrow">Join RaceDay</p>
    <h1 id="register-heading">Create your account</h1>
    <p class="account-card__intro">Create a Participant account to get started.</p>

    @if (ViewData["ApiMessage"] is string message)
    {
        <div class="account-message" role="alert">@message</div>
    }

    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

    <form asp-action="Register" method="post" class="account-form">
        <div class="form-field">
            <label asp-for="FirstName"></label>
            <input asp-for="FirstName" autocomplete="given-name" />
            <span asp-validation-for="FirstName" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="LastName"></label>
            <input asp-for="LastName" autocomplete="family-name" />
            <span asp-validation-for="LastName" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Email"></label>
            <input asp-for="Email" type="email" autocomplete="email" />
            <span asp-validation-for="Email" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="Password"></label>
            <input asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="field-error"></span>
        </div>
        <div class="form-field">
            <label asp-for="ConfirmPassword"></label>
            <input asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="field-error"></span>
        </div>
        <button class="account-button" type="submit">Create Participant account</button>
    </form>

    <p class="account-card__footnote">
        Already registered? <a asp-action="Login">Sign in</a>
    </p>
</section>
