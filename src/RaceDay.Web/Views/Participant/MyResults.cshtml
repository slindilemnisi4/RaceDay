@model RaceDay.Web.Models.Participant.MyResultsViewModel
@{
    ViewData["Title"] = "My Results";
}

<section class="participant-page" aria-labelledby="page-heading">
    <header class="participant-page__header">
        <p class="welcome__eyebrow">Participant</p>
        <h1 id="page-heading">My Results</h1>
        <p>View the results recorded for your race entries.</p>
    </header>

    @if (Model.State == RaceDay.Web.Models.Participant.ParticipantPageState.Failure)
    {
        <section class="event-state event-state--error" role="alert">
            <h2>Results are temporarily unavailable</h2>
            <p>@Model.Message</p>
            <a class="event-retry" asp-action="MyResults">Retry</a>
        </section>
    }
    else if (Model.State == RaceDay.Web.Models.Participant.ParticipantPageState.Empty)
    {
        <section class="event-state" aria-live="polite">
            <h2>No results yet</h2>
            <p>Your results will appear here after they are recorded.</p>
        </section>
    }
    else
    {
        <div class="participant-card-grid">
            @foreach (var result in Model.Results)
            {
                <article class="participant-card">
                    <div class="participant-card__heading">
                        <h2>@result.EventName</h2>
                        <span class="event-card__type">@result.ResultStatusLabel</span>
                    </div>
                    <dl class="event-card__details">
                        <div>
                            <dt>Category</dt>
                            <dd>@result.CategoryName</dd>
                        </div>
                        <div>
                            <dt>Finish time</dt>
                            <dd>@result.FinishTime.ToString(@"hh\:mm\:ss")</dd>
                        </div>
                        <div>
                            <dt>Overall position</dt>
                            <dd>@result.OverallPosition</dd>
                        </div>
                        <div>
                            <dt>Category position</dt>
                            <dd>@result.CategoryPosition</dd>
                        </div>
                    </dl>
                </article>
            }
        </div>
    }
</section>
