@model RaceDay.Web.Models.Participant.MyRacesViewModel
@{
    ViewData["Title"] = "My Races";
}

<section class="participant-page" aria-labelledby="page-heading">
    <header class="participant-page__header">
        <p class="welcome__eyebrow">Participant</p>
        <h1 id="page-heading">My Races</h1>
        <p>Review the events and categories you have joined.</p>
    </header>

    @if (Model.State == RaceDay.Web.Models.Participant.ParticipantPageState.Failure)
    {
        <section class="event-state event-state--error" role="alert">
            <h2>Races are temporarily unavailable</h2>
            <p>@Model.Message</p>
            <a class="event-retry" asp-action="MyRaces">Retry</a>
        </section>
    }
    else if (Model.State == RaceDay.Web.Models.Participant.ParticipantPageState.Empty)
    {
        <section class="event-state" aria-live="polite">
            <h2>You have not joined any races yet</h2>
            <p>Explore the available events and choose a category to join.</p>
            <a class="event-retry" asp-action="Join">Browse races</a>
        </section>
    }
    else
    {
        <div class="participant-card-grid">
            @foreach (var race in Model.Races)
            {
                <article class="participant-card">
                    <h2>@race.EventName</h2>
                    <dl class="event-card__details">
                        <div>
                            <dt>Event date</dt>
                            <dd>@(race.EventDate?.ToString("D") ?? "Details unavailable")</dd>
                        </div>
                        <div>
                            <dt>Location</dt>
                            <dd>@(string.IsNullOrWhiteSpace(race.Location) ? "Details unavailable" : race.Location)</dd>
                        </div>
                        <div>
                            <dt>Category</dt>
                            <dd>@race.CategoryName</dd>
                        </div>
                        <div>
                            <dt>Entry fee</dt>
                            <dd>@(race.EntryFee is decimal fee ? fee.ToString("C") : "Not available")</dd>
                        </div>
                        <div>
                            <dt>Joined</dt>
                            <dd>@race.EntryDate.ToString("D")</dd>
                        </div>
                    </dl>
                </article>
            }
        </div>
    }
</section>
