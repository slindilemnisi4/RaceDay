@model RaceDay.Web.Models.Events.EventDiscoveryViewModel
@{
    ViewData["Title"] = Model.State == RaceDay.Web.Models.Events.EventDiscoveryState.PublicLanding
        ? "RaceDay Web"
        : "Discover events";
}

@if (Model.State == RaceDay.Web.Models.Events.EventDiscoveryState.PublicLanding)
{
    <section class="welcome" aria-labelledby="welcome-heading">
        <p class="welcome__eyebrow">RaceDay</p>
        <h1 id="welcome-heading">Your RaceDay web application is running.</h1>
        <p>Sign in to discover upcoming races and events.</p>
    </section>
}
else
{
    <section class="event-discovery" aria-labelledby="events-heading">
        <header class="event-discovery__header">
            <p class="welcome__eyebrow">RaceDay</p>
            <h1 id="events-heading">Discover events</h1>
            <p>Explore races and events from the RaceDay community.</p>
        </header>

        @if (Model.State == RaceDay.Web.Models.Events.EventDiscoveryState.Failure)
        {
            <section class="event-state event-state--error" role="alert">
                <h2>@(Model.Message is null ? "Events are temporarily unavailable" : "Access to events denied")</h2>
                <p>@(Model.Message ?? "We couldn't load events right now. Please try again.")</p>
                <a class="event-retry" asp-controller="Home" asp-action="Index">Retry</a>
            </section>
        }
        else if (Model.State == RaceDay.Web.Models.Events.EventDiscoveryState.Empty)
        {
            <section class="event-state" aria-live="polite">
                <h2>No events yet</h2>
                <p>There are no events to show right now. Please check back later.</p>
            </section>
        }
        else
        {
            <div class="event-grid">
                @foreach (var eventItem in Model.Events)
                {
                    <article class="event-card @(eventItem.IsCancelled ? "event-card--cancelled" : null)">
                        <div class="event-card__heading">
                            <partial name="_EventTypeIndicator" model="eventItem.EventType" />
                            <h2>@eventItem.EventName</h2>
                        </div>
                        @if (eventItem.IsCancelled)
                        {
                            <p class="event-status event-status--cancelled">CANCELLED</p>
                        }
                        <p class="event-card__description">
                            @(string.IsNullOrWhiteSpace(eventItem.Description)
                                ? "No description provided."
                                : eventItem.Description)
                        </p>
                        <dl class="event-card__details">
                            <div>
                                <dt>Date</dt>
                                <dd>@eventItem.EventDate.ToString("D")</dd>
                            </div>
                            <div>
                                <dt>Location</dt>
                                <dd>@eventItem.Location</dd>
                            </div>
                            <div>
                                <dt>Distance</dt>
                                <dd>@eventItem.DistanceKM.ToString("0.##") km</dd>
                            </div>
                            <div>
                                <dt>Entry fee</dt>
                                <dd>@eventItem.EntryFeeLabel</dd>
                            </div>
                            <div>
                                <dt>Registration deadline</dt>
                                <dd>@eventItem.RegistrationDeadline.ToString("D")</dd>
                            </div>
                        </dl>

                        @if (User.IsInRole("Participant") && !eventItem.IsCancelled)
                        {
                            <a class="event-retry"
                               asp-controller="Participant"
                               asp-action="Join"
                               asp-route-eventID="@eventItem.EventID">Choose a category</a>
                        }
                        else if (User.IsInRole("Participant") && eventItem.IsCancelled)
                        {
                            <p class="event-card__join-message">Enrolment is unavailable for cancelled events.</p>
                        }
                    </article>
                }
            </div>
        }
    </section>
}
