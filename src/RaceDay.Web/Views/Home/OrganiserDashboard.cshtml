@model RaceDay.Web.Models.Organiser.OrganiserDashboardViewModel
@{
    ViewData["Title"] = "Organiser dashboard";
}

<section class="participant-page" aria-labelledby="page-heading">
    <header class="participant-page__header">
        <p class="welcome__eyebrow">Organiser</p>
        <h1 id="page-heading">Your dashboard</h1>
        <p>Explore events created by organisers across RaceDay.</p>
    </header>

    <section class="participant-page" aria-labelledby="platform-events-heading">
        <h2 id="platform-events-heading">Events across RaceDay</h2>
        @if (Model.State == RaceDay.Web.Models.Organiser.OrganiserPageState.Failure)
        {
            <section class="event-state event-state--error" role="alert">
                <h3>RaceDay events are temporarily unavailable</h3>
                <p>@Model.Message</p>
                <a class="event-retry" asp-controller="Home" asp-action="Index">Retry</a>
            </section>
        }
        else if (Model.State == RaceDay.Web.Models.Organiser.OrganiserPageState.Empty)
        {
            <section class="event-state" aria-live="polite">
                <h3>No events yet</h3>
                <p>There are no events available across RaceDay right now.</p>
            </section>
        }
        else
        {
            <div class="event-grid">
                @foreach (var eventItem in Model.Events)
                {
                    <article class="event-card @(eventItem.IsCancelled ? "event-card--cancelled" : null)">
                        <div class="event-card__heading">
                            <partial name="_EventTypeIndicator" model="eventItem.EventType" />
                            <h2>@eventItem.EventName</h2>
                        </div>
                        @if (eventItem.IsCancelled)
                        {
                            <p class="event-status event-status--cancelled">CANCELLED</p>
                        }
                        <p class="event-card__description">@eventItem.Description</p>
                        <dl class="event-card__details">
                            <div><dt>Date</dt><dd>@eventItem.EventDate.ToString("D")</dd></div>
                            <div><dt>Location</dt><dd>@eventItem.Location</dd></div>
                            <div><dt>Distance</dt><dd>@eventItem.DistanceKM.ToString("0.##") km</dd></div>
                            <div><dt>Entry fee</dt><dd>@eventItem.EntryFeeLabel</dd></div>
                        </dl>
                    </article>
                }
            </div>
        }
    </section>
</section>
