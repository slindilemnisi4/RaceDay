@model RaceDay.Web.Models.Organiser.OrganiserEventFormViewModel
@{
    var formAction = ViewData["FormAction"]?.ToString() ?? "CreateEvent";
}
<form asp-action="@formAction" asp-route-id="@Model.EventID" method="post" class="participant-card">
    <div asp-validation-summary="ModelOnly" class="event-state event-state--error" role="alert"></div>
    <div class="form-field">
        <label asp-for="EventName"></label>
        <input asp-for="EventName" />
        <span asp-validation-for="EventName"></span>
    </div>
    <div class="form-field">
        <label asp-for="Description"></label>
        <textarea asp-for="Description" rows="4"></textarea>
        <span asp-validation-for="Description"></span>
    </div>
    <div class="form-field">
        <label asp-for="EventDate"></label>
        <input asp-for="EventDate" type="date" />
        <span asp-validation-for="EventDate"></span>
    </div>
    <div class="form-field">
        <label asp-for="Location"></label>
        <input asp-for="Location" />
        <span asp-validation-for="Location"></span>
    </div>
    <div class="form-field">
        <label asp-for="DistanceKM"></label>
        <input asp-for="DistanceKM" type="number" min="0.01" step="0.01" />
        <span asp-validation-for="DistanceKM"></span>
    </div>
    <div class="form-field">
        <label asp-for="EntryFee"></label>
        <input asp-for="EntryFee" type="number" min="0" max="99999999.99" step="0.01" />
        <span asp-validation-for="EntryFee"></span>
        <small>The event is created with a General Entry category at this fee. Set R0.00 for a free event.</small>
    </div>
    <div class="form-field">
        <label asp-for="EventType"></label>
        <select asp-for="EventType">
            <option value="0">Run</option>
            <option value="1">Walk</option>
            <option value="2">Cycle</option>
        </select>
        <span asp-validation-for="EventType"></span>
    </div>
    <div class="form-field">
        <label asp-for="RegistrationDeadline"></label>
        <input asp-for="RegistrationDeadline" type="date" />
        <span asp-validation-for="RegistrationDeadline"></span>
    </div>
    <div class="organiser-actions">
        <button class="event-retry" type="submit">Save event</button>
        <a class="event-retry" asp-action="MyEvents">Cancel</a>
    </div>
</form>
