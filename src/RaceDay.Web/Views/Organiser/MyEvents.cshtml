@model RaceDay.Web.Models.Organiser.OrganiserEventsPageViewModel
@{
    ViewData["Title"] = "My events";
}

<section class="participant-page" aria-labelledby="page-heading">
    <header class="participant-page__header">
        <p class="welcome__eyebrow">Organiser</p>
        <h1 id="page-heading">My Events</h1>
        <p>View and manage the events you organise.</p>
        <a class="event-retry" asp-action="CreateEvent">Create event</a>
    </header>
    @if (TempData["OrganiserMessage"] is string message)
    {
        <p class="event-state" role="status">@message</p>
    }
    @if (TempData["OrganiserError"] is string error)
    {
        <p class="event-state event-state--error" role="alert">@error</p>
    }
    @if (Model.State == RaceDay.Web.Models.Organiser.OrganiserPageState.Failure)
    {
        <section class="event-state event-state--error" role="alert">
            <h2>Events are temporarily unavailable</h2>
            <p>@Model.Message</p>
            <a class="event-retry" asp-action="MyEvents">Retry</a>
        </section>
    }
    else if (Model.State == RaceDay.Web.Models.Organiser.OrganiserPageState.Empty)
    {
        <section class="event-state" aria-live="polite">
            <h2>No events yet</h2>
            <p>Create an event to get started.</p>
        </section>
    }
    else
    {
        <div class="participant-card-grid">
            @foreach (var item in Model.Events)
            {
                <article class="participant-card @(item.IsCancelled ? "event-card--cancelled" : null)">
                    <partial name="_EventTypeIndicator" model="item.EventType" />
                    @if (item.IsCancelled)
                    {
                        <p class="event-status event-status--cancelled">CANCELLED</p>
                    }
                    <h2>@item.EventName</h2>
                    <p>@item.Description</p>
                    <dl class="event-card__details">
                        <div><dt>Date</dt><dd>@item.EventDate.ToString("D")</dd></div>
                        <div><dt>Location</dt><dd>@item.Location</dd></div>
                        <div><dt>Distance</dt><dd>@item.DistanceKM.ToString("0.##") km</dd></div>
                        <div><dt>Entry fee</dt><dd>@item.EntryFeeLabel</dd></div>
                        <div><dt>Enrolments</dt><dd>@(item.TotalEnrolments?.ToString() ?? "Unavailable")</dd></div>
                    </dl>
                    <a class="event-retry" asp-action="Details" asp-route-id="@item.EventID">Manage event</a>
                    @if (!item.IsCancelled)
                    {
                        <div class="organiser-actions">
                            <a class="event-retry" asp-action="EditEvent" asp-route-id="@item.EventID">Edit</a>
                            <form asp-action="CancelEvent" asp-route-id="@item.EventID" method="post"
                                  onsubmit="return confirm('Cancel this event? Existing enrolments and results will be kept.');">
                                <button class="event-retry event-retry--danger" type="submit">Cancel event</button>
                            </form>
                        </div>
                    }
                </article>
            }
        </div>
    }
</section>
