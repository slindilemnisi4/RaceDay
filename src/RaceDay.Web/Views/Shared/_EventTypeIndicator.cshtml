@model int
@{
    var (label, iconPath) = Model switch
    {
        0 => ("Run", "~/images/event-types/running.png"),
        1 => ("Walk", "~/images/event-types/walking.png"),
        2 => ("Cycle", "~/images/event-types/cycling.png"),
        _ => ("Unknown event type", null)
    };
}
<span class="event-type-indicator">
    @if (iconPath is not null)
    {
        <img class="event-type-indicator__icon"
             src="@iconPath"
             asp-append-version="true"
             alt=""
             aria-hidden="true" />
    }
    <span class="event-type-indicator__label">@label</span>
</span>
